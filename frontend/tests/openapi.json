{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenCommune API",
    "version": "0.1.0",
    "description": "Read-only JSON API of OpenCommune, the open archive of the documents Swiss communes publish on their websites. No key, no account. The data is free to use under CC0 1.0; a citation is appreciated.\n\nTitles, bodies, dates and sections come from an automatic classification by a language model that no person has checked yet. Private people's names appear as [name].\n\nAI agents can use the same data over MCP: `http://127.0.0.1:8013/mcp` (streamable HTTP, tools `search_documents`, `get_document`, `list_communes`).",
    "license": {
      "name": "CC0 1.0 (the data)",
      "identifier": "CC0-1.0"
    },
    "contact": {
      "url": "http://127.0.0.1:8013"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8013"
    }
  ],
  "tags": [
    {
      "name": "Documents",
      "description": "Files, their sections and where they are."
    },
    {
      "name": "Communes",
      "description": "The communes and the coverage register."
    },
    {
      "name": "API",
      "description": "This description."
    }
  ],
  "paths": {
    "/api/communes": {
      "get": {
        "operationId": "listCommunes",
        "tags": ["Communes"],
        "summary": "Every commune of the archive, by canton and name, with its number of documents",
        "description": "Every commune of the archive, by canton and name, with its number of documents.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The communes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Commune"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/communes/{bfs_id}": {
      "get": {
        "operationId": "getCommune",
        "tags": ["Communes"],
        "summary": "One commune: its register entry, access problems of its website, and its documents per year and section family",
        "description": "One commune: its register entry, access problems of its website, and its documents per year and section family.",
        "parameters": [
          {
            "name": "bfs_id",
            "in": "path",
            "required": true,
            "description": "The commune's BFS number.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The commune.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommuneDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not in the archive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/register": {
      "get": {
        "operationId": "listRegister",
        "tags": ["Communes"],
        "summary": "The coverage register: for every Swiss commune, what it publishes and whether the archive collects it",
        "description": "The coverage register: for every Swiss commune, what it publishes and whether the archive collects it.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The register entries.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RegisterEntry"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/documents": {
      "get": {
        "operationId": "searchDocuments",
        "tags": ["Documents"],
        "summary": "The documents that match, newest first, with counts per year, section type and body",
        "description": "The documents that match, newest first, with counts per year, section type and body. Each count applies every filter except its own.",
        "parameters": [
          {
            "name": "commune",
            "in": "query",
            "required": false,
            "description": "A commune's BFS number (from list_communes): the documents it links.",
            "schema": {
              "type": ["integer", "null"],
              "format": "int64",
              "default": null
            }
          },
          {
            "name": "section",
            "in": "query",
            "required": false,
            "description": "A section type: documents with at least one section of this type. One of minutes,\ndecisions, vote_result, budget, accounts, invitation_agenda, proposal, member_request,\nregulation, report, notice, plan_or_map, news, other, unclear.",
            "schema": {
              "type": ["string", "null"],
              "default": null
            }
          },
          {
            "name": "family",
            "in": "query",
            "required": false,
            "description": "A section family (deliberation, money, proposals, rules, information, other): documents\nwith at least one section of it.",
            "schema": {
              "type": ["string", "null"],
              "default": null
            }
          },
          {
            "name": "body",
            "in": "query",
            "required": false,
            "description": "The kind of body behind the document. One of parliament, citizens_assembly, executive,\ncommission, commune, other_public_body, private, unknown.",
            "schema": {
              "type": ["string", "null"],
              "default": null
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "description": "The document's year: of its date, else the one year the classifier read, else of the\ncommune's listing date.",
            "schema": {
              "type": ["integer", "null"],
              "format": "int64",
              "default": null
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Text the document's title contains, case-insensitive.",
            "schema": {
              "type": ["string", "null"],
              "default": null
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Documents to skip.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Documents to return, 0 to 100.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of documents.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentPage"
                }
              }
            }
          },
          "400": {
            "description": "An invalid parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{sha256}": {
      "get": {
        "operationId": "getDocument",
        "tags": ["Documents"],
        "summary": "One document with the classification run behind its fields",
        "description": "One document with the classification run behind its fields.",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "description": "The file's SHA-256, from a document list.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The document.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not in the archive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "get": {
        "operationId": "listRuns",
        "tags": ["Documents"],
        "summary": "The classification runs, with every setting that changes what they saw and a note on what those settings do to the data",
        "description": "The classification runs, with every setting that changes what they saw and a note on what those settings do to the data.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The runs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Run"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "tags": ["API"],
        "summary": "This description",
        "description": "This description.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/original/{sha256}": {
      "get": {
        "operationId": "openOriginal",
        "tags": ["Documents"],
        "summary": "Redirects to the file on the commune's website",
        "description": "Redirects to the file on the commune's website.",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "description": "The file's SHA-256, from a document list.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commune",
            "in": "query",
            "required": false,
            "description": "A commune's BFS number: that commune's link, when it has one.",
            "schema": {
              "type": ["integer", "null"],
              "format": "int64"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Open the file at this page (`#page=`, which PDF viewers follow).",
            "schema": {
              "type": ["integer", "null"],
              "format": "uint32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "302": {
            "description": "The file's address on the commune's website.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not in the archive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
