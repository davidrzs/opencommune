[Unit]
Description=Tractanda crawl: drain discovered archive backlogs in finite batches
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/tractanda
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash deploy/crawl.sh backlog
Nice=10
TimeoutStartSec=8h
