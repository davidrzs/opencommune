# Copy to .env. Everything has a working default.

# Where crawl state, raw documents, processing outputs and the database live (outside git).
DATA_DIR=data
# The checked-in configuration (communes.yaml, source lists, register). Defaults to DATA_DIR; set it
# when DATA_DIR is outside the repository, e.g. DATA_DIR=/srv/opencommune with CONFIG_DIR=data.
# CONFIG_DIR=data
# Optional existing directory for raw documents, sidecars and the URL index (e.g. another disk).
# A configured directory that is missing is an error, never an empty archive.
# RAW_DATA_DIR=/srv/opencommune-raw
DATABASE_URL=sqlite:///data/opencommune.db

# Crawler. The User-Agent names the project and its contact page; the delay applies per host and per
# hosting network; downloads pause while the raw archive's filesystem has less free space than this.
# USER_AGENT=
# REQUEST_DELAY_SECONDS=1.0
# RAW_MIN_FREE_BYTES=1073741824

# Classification (opencommune classify). The key is needed to send requests only; rendered
# requests wait in SCRATCH_DIR (default DATA_DIR/scratch) until they are answered.
# OPENAI_API_KEY=
# SCRATCH_DIR=/srv/scratch/opencommune

# Web server (server/): read by the Rust binary, not by the Python package.
# DATABASE_PATH=data/opencommune.db
# STATIC_DIR=frontend/build
# BIND=127.0.0.1:8000
# USAGE_PATH=data/logs/usage.sqlite3
# USAGE_ENABLED=true
# USAGE_VISITORS=true
# PUBLIC_URL=http://127.0.0.1:8000
# SEARCH_INDEXING=false
